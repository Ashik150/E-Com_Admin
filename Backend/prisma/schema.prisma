// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RoleStatus {
  ACTIVE
  INACTIVE
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum MediaType {
  IMAGE
  VIDEO
}

enum BrandStatus {
  ACTIVE
  INACTIVE
}

enum AttributeType {
  DROPDOWN
  RADIO
  CHECKBOX
  COLOR_SWATCH
  IMAGE_SWATCH
}

enum StockStatus {
  IN_STOCK
  LOW_STOCK
  OUT_OF_STOCK
}

model User {
  id              String           @id @default(uuid()) @db.Uuid
  name            String
  email           String           @unique
  passwordHash    String
  phone           String?
  gender          Gender?
  avatarUrl       String?
  active          Boolean          @default(true)
  roleId          String           @db.Uuid
  deletedAt       DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  role            Role             @relation(fields: [roleId], references: [id], onDelete: Restrict)
  refreshSessions RefreshSession[]
  mediaAssets     MediaAsset[]

  @@index([roleId])
  @@index([active, deletedAt])
  @@map("users")
}

model MediaAsset {
  id                   String                @id @default(uuid()) @db.Uuid
  fileName             String
  storedPath           String                @unique
  publicUrl            String
  mimeType             String
  type                 MediaType
  size                 Int
  width                Int?
  height               Int?
  thumbnailPath        String?               @unique
  thumbnailUrl         String?
  altText              String?
  title                String?
  uploadedById         String                @db.Uuid
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  uploadedBy           User                  @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  categories           Category[]
  brandLogos           Brand[]
  attributeValueImages AttributeValue[]
  productMedia         ProductMedia[]
  variantMedia         ProductVariantMedia[]
  attributeValueMedia  AttributeValueMedia[]

  @@index([uploadedById])
  @@index([type, createdAt])
  @@map("media_assets")
}

model Brand {
  id          String      @id @default(uuid()) @db.Uuid
  name        String      @unique
  slug        String      @unique
  description String?
  logoId      String?     @db.Uuid
  status      BrandStatus @default(ACTIVE)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  logo        MediaAsset? @relation(fields: [logoId], references: [id], onDelete: Restrict)
  products    Product[]

  @@index([logoId])
  @@index([status, name])
  @@map("brands")
}

model Attribute {
  id            String                @id @default(uuid()) @db.Uuid
  name          String                @unique
  slug          String                @unique
  type          AttributeType
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  values        AttributeValue[]
  variantValues ProductVariantValue[]

  @@index([type, name])
  @@map("attributes")
}

model AttributeValue {
  id            String                @id @default(uuid()) @db.Uuid
  attributeId   String                @db.Uuid
  value         String
  slug          String
  colorValue    String?
  imageId       String?               @db.Uuid
  sortOrder     Int                   @default(0)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  attribute     Attribute             @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  image         MediaAsset?           @relation(fields: [imageId], references: [id], onDelete: Restrict)
  variantValues ProductVariantValue[]
  media         AttributeValueMedia[]

  @@unique([attributeId, slug])
  @@unique([id, attributeId])
  @@index([attributeId, sortOrder])
  @@index([imageId])
  @@map("attribute_values")
}

model Category {
  id          String            @id @default(uuid()) @db.Uuid
  name        String
  slug        String            @unique
  description String?
  imageId     String?           @db.Uuid
  parentId    String?           @db.Uuid
  active      Boolean           @default(true)
  sortOrder   Int               @default(0)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  image       MediaAsset?       @relation(fields: [imageId], references: [id], onDelete: Restrict)
  parent      Category?         @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children    Category[]        @relation("CategoryTree")
  products    ProductCategory[]

  @@index([parentId, sortOrder])
  @@index([active, sortOrder])
  @@index([imageId])
  @@map("categories")
}

model Product {
  id               String            @id @default(uuid()) @db.Uuid
  name             String
  slug             String            @unique
  sku              String?           @unique
  shortDescription String?
  longDescription  String?
  hasVariants      Boolean           @default(false)
  price            Decimal?          @db.Decimal(12, 2)
  salePrice        Decimal?          @db.Decimal(12, 2)
  stock            Int?
  stockStatus      StockStatus?
  weight           Decimal?          @db.Decimal(10, 3)
  active           Boolean           @default(true)
  featured         Boolean           @default(false)
  sortOrder        Int               @default(0)
  brandId          String?           @db.Uuid
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  brand            Brand?            @relation(fields: [brandId], references: [id], onDelete: Restrict)
  categories       ProductCategory[]
  media            ProductMedia[]
  variants         ProductVariant[]

  @@index([brandId])
  @@index([active, sortOrder])
  @@index([name])
  @@map("products")
}

model ProductCategory {
  productId  String   @db.Uuid
  categoryId String   @db.Uuid
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@id([productId, categoryId])
  @@index([categoryId])
  @@map("product_categories")
}

model ProductMedia {
  productId   String     @db.Uuid
  mediaId     String     @db.Uuid
  isThumbnail Boolean    @default(false)
  isGallery   Boolean    @default(true)
  sortOrder   Int        @default(0)
  product     Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  media       MediaAsset @relation(fields: [mediaId], references: [id], onDelete: Restrict)

  @@id([productId, mediaId])
  @@index([mediaId])
  @@index([productId, sortOrder])
  @@map("product_media")
}

model ProductVariant {
  id                String                @id @default(uuid()) @db.Uuid
  productId         String                @db.Uuid
  sku               String                @unique
  combinationKey    String
  price             Decimal               @db.Decimal(12, 2)
  salePrice         Decimal?              @db.Decimal(12, 2)
  stock             Int
  stockStatus       StockStatus
  lowStockThreshold Int                   @default(0)
  weight            Decimal?              @db.Decimal(10, 3)
  active            Boolean               @default(true)
  purchasable       Boolean               @default(true)
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  product           Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  values            ProductVariantValue[]
  media             ProductVariantMedia[]

  @@unique([productId, combinationKey])
  @@index([productId, active])
  @@index([stockStatus])
  @@map("product_variants")
}

model ProductVariantValue {
  variantId        String         @db.Uuid
  attributeId      String         @db.Uuid
  attributeValueId String         @db.Uuid
  variant          ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  attribute        Attribute      @relation(fields: [attributeId], references: [id], onDelete: Restrict)
  attributeValue   AttributeValue @relation(fields: [attributeValueId, attributeId], references: [id, attributeId], onDelete: Restrict)

  @@id([variantId, attributeId])
  @@index([attributeValueId, attributeId])
  @@map("product_variant_values")
}

model ProductVariantMedia {
  variantId   String         @db.Uuid
  mediaId     String         @db.Uuid
  isThumbnail Boolean        @default(false)
  isGallery   Boolean        @default(true)
  sortOrder   Int            @default(0)
  variant     ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  media       MediaAsset     @relation(fields: [mediaId], references: [id], onDelete: Restrict)

  @@id([variantId, mediaId])
  @@index([mediaId])
  @@index([variantId, sortOrder])
  @@map("product_variant_media")
}

model AttributeValueMedia {
  attributeValueId String         @db.Uuid
  mediaId          String         @db.Uuid
  sortOrder        Int            @default(0)
  attributeValue   AttributeValue @relation(fields: [attributeValueId], references: [id], onDelete: Cascade)
  media            MediaAsset     @relation(fields: [mediaId], references: [id], onDelete: Restrict)

  @@id([attributeValueId, mediaId])
  @@index([mediaId])
  @@index([attributeValueId, sortOrder])
  @@map("attribute_value_media")
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  name        String           @unique
  description String?
  status      RoleStatus       @default(ACTIVE)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  users       User[]
  permissions RolePermission[]

  @@map("roles")
}

model PermissionGroup {
  id          String       @id @default(uuid()) @db.Uuid
  name        String       @unique
  slug        String       @unique
  description String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  permissions Permission[]

  @@map("permission_groups")
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  name        String           @unique
  description String?
  groupId     String           @db.Uuid
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  group       PermissionGroup  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  roles       RolePermission[]

  @@index([groupId])
  @@map("permissions")
}

model RolePermission {
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  assignedAt   DateTime   @default(now())
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model RefreshSession {
  id           String          @id @default(uuid()) @db.Uuid
  userId       String          @db.Uuid
  familyId     String          @db.Uuid
  tokenHash    String          @unique
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?         @unique @db.Uuid
  createdAt    DateTime        @default(now())
  lastUsedAt   DateTime?
  createdByIp  String?
  lastUsedIp   String?
  userAgent    String?
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  replacedBy   RefreshSession? @relation("RefreshRotation", fields: [replacedById], references: [id], onDelete: SetNull)
  replaces     RefreshSession? @relation("RefreshRotation")

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("refresh_sessions")
}
