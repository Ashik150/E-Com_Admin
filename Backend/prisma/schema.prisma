// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RoleStatus {
  ACTIVE
  INACTIVE
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum MediaType {
  IMAGE
  VIDEO
}

enum BrandStatus {
  ACTIVE
  INACTIVE
}

enum AttributeType {
  DROPDOWN
  RADIO
  CHECKBOX
  COLOR_SWATCH
  IMAGE_SWATCH
}

model User {
  id              String           @id @default(uuid()) @db.Uuid
  name            String
  email           String           @unique
  passwordHash    String
  phone           String?
  gender          Gender?
  avatarUrl       String?
  active          Boolean          @default(true)
  roleId          String           @db.Uuid
  deletedAt       DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  role            Role             @relation(fields: [roleId], references: [id], onDelete: Restrict)
  refreshSessions RefreshSession[]
  mediaAssets     MediaAsset[]

  @@index([roleId])
  @@index([active, deletedAt])
  @@map("users")
}

model MediaAsset {
  id                   String           @id @default(uuid()) @db.Uuid
  fileName             String
  storedPath           String           @unique
  publicUrl            String
  mimeType             String
  type                 MediaType
  size                 Int
  width                Int?
  height               Int?
  thumbnailPath        String?          @unique
  thumbnailUrl         String?
  altText              String?
  title                String?
  uploadedById         String           @db.Uuid
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  uploadedBy           User             @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  categories           Category[]
  brandLogos           Brand[]
  attributeValueImages AttributeValue[]

  @@index([uploadedById])
  @@index([type, createdAt])
  @@map("media_assets")
}

model Brand {
  id          String      @id @default(uuid()) @db.Uuid
  name        String      @unique
  slug        String      @unique
  description String?
  logoId      String?     @db.Uuid
  status      BrandStatus @default(ACTIVE)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  logo        MediaAsset? @relation(fields: [logoId], references: [id], onDelete: Restrict)

  @@index([logoId])
  @@index([status, name])
  @@map("brands")
}

model Attribute {
  id        String           @id @default(uuid()) @db.Uuid
  name      String           @unique
  slug      String           @unique
  type      AttributeType
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  values    AttributeValue[]

  @@index([type, name])
  @@map("attributes")
}

model AttributeValue {
  id          String      @id @default(uuid()) @db.Uuid
  attributeId String      @db.Uuid
  value       String
  slug        String
  colorValue  String?
  imageId     String?     @db.Uuid
  sortOrder   Int         @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  attribute   Attribute   @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  image       MediaAsset? @relation(fields: [imageId], references: [id], onDelete: Restrict)

  @@unique([attributeId, slug])
  @@index([attributeId, sortOrder])
  @@index([imageId])
  @@map("attribute_values")
}

model Category {
  id          String      @id @default(uuid()) @db.Uuid
  name        String
  slug        String      @unique
  description String?
  imageId     String?     @db.Uuid
  parentId    String?     @db.Uuid
  active      Boolean     @default(true)
  sortOrder   Int         @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  image       MediaAsset? @relation(fields: [imageId], references: [id], onDelete: Restrict)
  parent      Category?   @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children    Category[]  @relation("CategoryTree")

  @@index([parentId, sortOrder])
  @@index([active, sortOrder])
  @@index([imageId])
  @@map("categories")
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  name        String           @unique
  description String?
  status      RoleStatus       @default(ACTIVE)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  users       User[]
  permissions RolePermission[]

  @@map("roles")
}

model PermissionGroup {
  id          String       @id @default(uuid()) @db.Uuid
  name        String       @unique
  slug        String       @unique
  description String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  permissions Permission[]

  @@map("permission_groups")
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  name        String           @unique
  description String?
  groupId     String           @db.Uuid
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  group       PermissionGroup  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  roles       RolePermission[]

  @@index([groupId])
  @@map("permissions")
}

model RolePermission {
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  assignedAt   DateTime   @default(now())
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model RefreshSession {
  id           String          @id @default(uuid()) @db.Uuid
  userId       String          @db.Uuid
  familyId     String          @db.Uuid
  tokenHash    String          @unique
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?         @unique @db.Uuid
  createdAt    DateTime        @default(now())
  lastUsedAt   DateTime?
  createdByIp  String?
  lastUsedIp   String?
  userAgent    String?
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  replacedBy   RefreshSession? @relation("RefreshRotation", fields: [replacedById], references: [id], onDelete: SetNull)
  replaces     RefreshSession? @relation("RefreshRotation")

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("refresh_sessions")
}
