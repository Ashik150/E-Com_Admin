NODE_ENV="development"
PORT="3000"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/trends_bird?schema=public"
FRONTEND_URL="http://localhost:5173"
JWT_ACCESS_SECRET="replace-with-at-least-32-random-characters"
JWT_ACCESS_ISSUER="trends-bird-api"
JWT_ACCESS_AUDIENCE="trends-bird-dashboard"
JWT_ACCESS_TTL_SECONDS="900"
REFRESH_TOKEN_TTL_DAYS="14"
COOKIE_SECURE="false"
MEDIA_STORAGE_DIR="uploads"
MEDIA_MAX_FILE_SIZE_MB="10"
MEDIA_MAX_FILES="10"
SEED_ADMIN_EMAIL="admin@trendsbird.com"
SEED_ADMIN_PASSWORD="Admin@12345"
SEED_CATALOG_EMAIL="catalog@trendsbird.com"
SEED_CATALOG_PASSWORD="Catalog@12345"
